<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/loginbackground"
        android:scaleType="centerCrop" />

    <!-- Glass Card Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="24dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="10dp"
        android:backgroundTint="#CCFFFFFF"> <!-- Dim glass background -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Logo Inside Card -->
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/baseline_account_circle_24"
                    android:contentDescription="Logo" />

                <TextView
                    android:text="Login"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"
                    android:textColor="#FF5722"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <!-- Email -->
                <EditText
                    android:id="@+id/emailLogin"
                    android:hint="Email"
                    android:textStyle="bold"
                    android:inputType="textEmailAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <!-- Password -->
                <EditText
                    android:id="@+id/passwordLogin"
                    android:hint="Password"
                    android:textStyle="bold"
                    android:inputType="textPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" />

                <!-- Role -->
                <RadioGroup
                    android:id="@+id/loginRoleRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/radioCustomer"
                        android:text="Customer"
                        android:buttonTint="@color/orange_radio_selector"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <RadioButton
                        android:id="@+id/radioWaiter"
                        android:text="Waiter"
                        android:buttonTint="@color/orange_radio_selector"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <RadioButton
                        android:id="@+id/radioChef"
                        android:text="Chef"
                        android:buttonTint="@color/orange_radio_selector"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <RadioButton
                        android:id="@+id/radioManager"
                        android:text="Manager"
                        android:buttonTint="@color/orange_radio_selector"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </RadioGroup>

                <!-- Login Button -->
                <Button
                    android:id="@+id/loginButtonSubmit"
                    android:text="Login"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#FF5722"
                    android:textColor="#000000" />

                <!-- Create Account Text -->
                <TextView
                    android:id="@+id/createAccountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="If you don't have an account, create one!"
                    android:textColor="#FF5722"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:gravity="center" />

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>


</RelativeLayout>
