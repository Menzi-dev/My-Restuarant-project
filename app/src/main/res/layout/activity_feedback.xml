<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="127dp"
        android:background="#FF5722"
        android:layout_marginTop="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="316dp"
            android:layout_height="61dp"
            android:layout_weight="1"
            android:text="Share Your Feedback"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="51dp"
            android:layout_height="111dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Feedback Input -->
    <EditText
        android:id="@+id/feedbackInput"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_below="@id/headerBar"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/edit_text"
        android:backgroundTint="#FFEB3B"
        android:hint="Tell us about your experience..."
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:padding="10dp"
        android:textColor="#000000"
        android:textColorHint="#B0BEC5"
        android:textSize="16sp" />

    <!-- Rating Label -->
    <TextView
        android:id="@+id/ratingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/feedbackInput"
        android:layout_marginBottom="8dp"
        android:text="Rate Your Experience"
        android:textColor="#1E3A8A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Star Rating -->
    <LinearLayout
        android:id="@+id/starRatingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ratingLabel"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/star1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:src="@android:drawable/star_big_off"
            android:contentDescription="Star 1"
            app:tint="#B0BEC5" />

        <ImageView
            android:id="@+id/star2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:src="@android:drawable/star_big_off"
            android:contentDescription="Star 2"
            app:tint="#B0BEC5" />

        <ImageView
            android:id="@+id/star3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:src="@android:drawable/star_big_off"
            android:contentDescription="Star 3"
            app:tint="#B0BEC5" />

        <ImageView
            android:id="@+id/star4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:src="@android:drawable/star_big_off"
            android:contentDescription="Star 4"
            app:tint="#B0BEC5" />

        <ImageView
            android:id="@+id/star5"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/star_big_off"
            android:contentDescription="Star 5"
            app:tint="#B0BEC5" />
    </LinearLayout>

    <!-- Anonymous Checkbox -->
    <CheckBox
        android:id="@+id/anonymousCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/starRatingContainer"
        android:layout_marginBottom="16dp"
        android:text="Submit Anonymously"
        android:textColor="#1E3A8A"
        android:textSize="16sp" />

    <!-- Submit Button -->
    <Button
        android:id="@+id/submitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/anonymousCheckBox"
        android:backgroundTint="#FFEB3B"
        android:text="Submit Feedback"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FF5722"
        android:padding="10dp" />
</RelativeLayout>